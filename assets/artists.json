":[{"n":"天宮つばき","r":"","x":"https://x.com/ASTRAILLtsubaki","i":""},{"n":"神樂紗那","r":"オーロラオレンジ","x":"https://x.com/ASTRAILL_sana","i":""},{"n":"蝶花なな","r":"","x":"https://x.com/ASTRAILL_nana","i":""},{"n":"真白みく","r":"","x":"https://x.com/ASTRAILL_miku","i":""},{"n":"三原海","r":"","x":"https://x.com/ASTRAILL_umi","i":""}]},"岡部紘樹":{"c":"音楽","p":"歌手・俳優。ドラマ「ごくせん」出演。大江戸温泉物語 箕面スパーガーデンにて「丘部紘輝」名義で歌謡歌手デビュー。姫路発歌謡ポップグループ「SHIRA-SAGI」のメンバー（白鷺ヒロキ）。昭和・平成の名曲を中心とした歌謡ショーを各地の温浴施設やショッピングモールで開催し、オリジナル曲でのソロライブも行う。関西を中心にLIVE活動中。","w":"https://hirowsolo.shopselect.net/","x":"https://x.com/o_hiroki0307","i":"https://www.instagram.com/hiroki_okabe0307/","al":["白鷺ヒロキ","丘部紘輝","Hiroki Okabe","オカベヒロキ"]},"SHIRA-SAGI":{"c":"メンズアイドル","p":"姫路発の歌謡ポップグループ。2026年9月6日に姫路市立図書館飾磨分館ホールでデビューLIVE。オリジナル曲「THE 姫〜HIMEJI〜」「THE 愛」など。温浴施設の歌謡ショーを中心に、姫路を拠点に関西で活動。四日市ゆうゆう会館「まねき隊」就任。メンバーは白鷺ゆうき・白鷺リョウ・白鷺ヒロキ・白鷺ダイスケの4人。","w":"https://h-shirasagi.com/","m":[{"n":"白鷺ゆうき","r":"","x":"","i":""},{"n":"白鷺リョウ","r":"","x":"","i":""},{"n":"白鷺ヒロキ","r":"","x":"https://x.com/o_hiroki0307","i":"https://www.instagram.com/hiroki_okabe0307/"},{"n":"白鷺ダイスケ","r":"","x":"","i":""}],"al":["白鷺","シラサギ"]},"GEN×SEN":{"c":"メンズアイドル","p":"温泉歌謡アイドル。温泉地で活動していたメンバーを中心に結成された男性4人組。グループ名は温泉の「源泉」と、「元気の元（GEN）」「優しさ（GENTLE）のGEN」を1000（SEN）倍届けたいという思いから。昭和・平成の歌謡曲を中心に、扇子・刀・番傘を使った和のパフォーマンスやマジックまで披露するショーで、温浴施設・ショッピングモール・地域イベントなど関西を中心に活動。地上波「びわ湖カンパニー」レギュラー出演中。スケジュールは公式XとTimeTree（GEN×SENスケジュール）で告知。","w":"https://merucias.work/gensen2/","x":"https://x.com/GENxSEN4","i":"https://www.instagram.com/gensen.official/","m":[{"n":"起田純平","r":"リーダー","x":"","i":""},{"n":"阿部晃介","r":"","x":"","i":""},{"n":"徳城慶太","r":"","x":"","i":""},{"n":"千輝直也","r":"プロマジシャン","x":"","i":""}],"al":["ゲンセン","GENxSEN","GEN SEN"]},"はっぴちゃん。":{"c":"お笑い","p":"松竹芸能所属のピン芸人。法被と鉢巻姿で、踊りを交えた漫談を行う。松竹ジャパングランプリ2019審査員特別賞、2022年「山-1グランプリ」優勝。ABC『おはよう朝日です』リポーター、MBSラジオ『サンデーライブ ゴエでSHOW！』、関西テレビ『旬感LIVE とれたてっ！』HAPPY探検隊など関西の番組でも活動。本名・戸谷莉菜（女優・タレント名義のプロフィールも松竹芸能にある）。2005年9月20日生まれ、大阪府出身。","w":"https://www.shochikugeino.co.jp/talents/happichan/","x":"https://x.com/happi_channel","i":"https://www.instagram.com/happichannel/","t":"https://www.tiktok.com/@happi881","al":["戸谷莉菜"]},"ももにゃん":{"c":"アイドル","p":"鳥取県出身のシンガーソングライター／アイドル。作詞作曲、手話歌、ミクチャ配信でも活動。2026年11月、新曲（虹のコンキスタドール『トライアングル・ドリーマー』の作詞作曲・村カワ基成による提供曲）を初披露。","x":"https://x.com/momonyan0909"},"吏桜":{"c":"音楽","p":"日本民謡協会／日本民謡ゆかり会（会主・湊由加里）所属の民謡歌手。3歳から民謡を始め、7歳で銭太鼓、10歳で三味線。2020年に民謡アンバサダー就任、東京2020オリンピック閉会式で東京音頭を歌唱。第31回淀川三十石船舟唄全国大会優勝（2023）、奈良県五大民謡全国大会で初瀬追分の部優勝・総合優勝（2024・2025）。関西大学在学中で、学生落語も行う。本名表記は増田吏桜。2005年生まれ、大阪府出身。","x":"https://x.com/minyo___rio","i":"https://www.instagram.com/minyo__rio","al":["増田吏桜","Rio Masuda"]},"yukaDD":{"c":"音楽","p":"1999年4月20日生まれ、大阪府出身のシンガー。「DD」には、4月の誕生石Diamond（ダイヤモンド）のように歌声でステージを魅了し光り輝くDiva（ディーバ）を目指すという意味が込められている。2020年1月に「Carry on」でメジャーデビュー。1stアルバム「21×21」収録「Superhero」は、幼い頃から大阪の同じダンススクールに通う憧れの先輩・TWICEのMOMOがMVに出演し200万回再生超え。幼少の頃に演歌に触れ、10歳の頃にクリスティーナ・アギレラに憧れを持ち、ごく自然とR&B、HIPHOPの歌唱スタイルを纏う。力強さと迫力を備え日本人離れした歌声で表現される圧倒的なパフォーマンス力が魅力の、次世代アーティスト。所属レーベルはavex trax。","w":"https://yukadd.jp/","x":"https://x.com/yukaDD_official","i":"https://www.instagram.com/yukadd_official/","t":"https://www.tiktok.com/@yukadd","al":["yukaDD(;´∀`)","ユカディーディー"]},"Keeper Girls":{},"PRIME":{"c":"ダンスボーカル","p":"伊丹市のご当地ダンス＆ボーカルユニット（男女混成）。伊丹中央サンロード商店街振興組合の若手有志が、商店街とまちの活性化の起爆剤として企画・プロデュース。2016年10月からメンバーを募集し、応募約120人の中から同年11月末に5人を選んで結成した。デビュー時の問い合わせ窓口はA-BEAT-PRO.（http://www.a-beat-pro.com）。\n\nデビューの時期は出典により表記が異なる。神戸新聞は2017年2月20日に同商店街でデビュー曲を披露したと報じ、伊丹市観光物産協会は2017年3月11日夜、三軒寺前広場（三軒寺前広場（伊丹市））の飲食イベント「伊丹郷町屋台村」でのステージを市民への初披露と報じている（両説併記）。デビュー曲は臨空都市・大阪（伊丹）空港にちなんだ「TAKE OFF!!」。神戸新聞は2017年4月1日に同曲をリリースと報じ、観光物産協会は2017年5月1日からデビューCD（「TAKE OFF!!」収録、税込1,080円）とオリジナル菓子がJR伊丹駅改札横の市立観光物産ギャラリーで販売されたと報じた。\n\n主な出演記録：伊丹郷町屋台村（2017-03-11・12、三軒寺前広場）、イオンモール伊丹の観光イベント（2017-05-27・28）、Vivaいたみサンロードフェスタ（2017-06-24、伊丹中央サンロード商店街、呑み屋横丁など2カ所で公演）。\n\n2018年1月、初期メンバーのうち4人が契約満了で卒業し、公演ごとに10人のタレントの中から出演メンバーを選抜する方式に変更された。2018年1月28日のイオンモール伊丹（1Fエンターテイメントコート）公演では、TATSURUと新メンバーのGENKI、NATSUKI、KOTOMI、M!YUが12:00／14:00／16:00の3ステージに出演。\n\nその後の活動終了・解散の時期は、2026-11-16時点の調査（公式・地元メディア・ブログ・ファン記録・Wayback）では確認できていない（要確認）。\n\n出典（いずれも2026-11-16取得）：伊丹市観光物産協会「伊丹のご当地ユニット『PRIME』デビュー」http://itami-kankou.com/news/48.html ／同協会2017年5月・2018年1月のニュース一覧 http://itami-kankou.com/date/2017/05 、http://itami-kankou.com/date/2018/01 ／同協会「サンロード商店街で活性化イベント」http://itami-kankou.com/news/1054.html ／神戸新聞NEXT「歌とダンスで伊丹PR 商店街の企画ユニット結成」（2017-02-21更新）https://www.kobe-np.co.jp/news/odekake-plus/news/detail.shtml?url=news%2Fodekake-plus%2Fnews%2Fpickup%2F201702%2F9934157","m":[{"n":"TATSURU（畑辺起津留）","r":"初期メンバー（2018年の選抜体制でも継続）","x":"","i":""},{"n":"Miyu（北端美優）","r":"初期メンバー（2018年1月に契約満了で卒業）","x":"","i":""},{"n":"ELIY（伊藤江梨）","r":"初期メンバー（2018年1月に契約満了で卒業）","x":"","i":""},{"n":"Hina（濱野陽菜）","r":"初期メンバー（2018年1月に契約満了で卒業）","x":"","i":""},{"n":"Kaede（（三輪楓）","r":"初期メンバー（2018年1月に契約満了で卒業）","x":"","i":""},{"n":"GENKI","r":"2018年選抜体制メンバー","x":"","i":""},{"n":"NATSUKI","r":"2018年選抜体制メンバー","x":"","i":""},{"n":"KOTOMI","r":"2018年選抜体制メンバー","x":"","i":""},{"n":"M!YU","r":"2018年選抜体制メンバー","x":"","i":""}],"al":["プライム"]},"はなひめ♡":{"c":"アイドル","p":"かほち・ひなぴによる期間限定ユニット。","m":[{"n":"かほち","r":"","x":"https://x.com/flower_walk0110","i":""},{"n":"ひなぴ","r":"","x":"","i":""}],"al":["はなひめ"]},"ひなぴ":{"c":"アイドル","p":"期間限定ユニット『はなひめ♡』のメンバー。"},"清水久美子":{"c":"ダンスボーカル","p":"関西を拠点に活動するシンガー（KMS RECORDS）。「関西で注目の超実力派シンガー」として多数のテレビ番組やメディアで特集されている。歌手活動と並行してボイストレーナー／ダンス講師／コレオグラファーとしても活躍し、京都市内でボーカル＆ダンススクール『★STARS』を主宰。イオンモールなど関西各地の大型商業施設で定期的にフリーライブを開催している。FMおとくに『清水久美子のサウンドガーデン』（毎週日曜18:00〜18:28）レギュラー出演。","w":"https://www.kmsrecords.co.jp/stars/top.html","x":"https://twitter.com/stars_kyk","al":["清水 久美子"]},"★STARS":{"c":"ダンスボーカル","p":"清水久美子が主宰する京都のボーカル＆ダンススクール『★STARS』、および清水久美子を中心に結成されたダンス＆ボーカルグループ。関西各地の大型イベントや商業施設のライブステージに出演している。","w":"https://www.kumiko-stars.com/","x":"https://twitter.com/stars_kyk","m":[{"n":"清水久美子","r":"主宰","x":"","i":""},{"n":"YUNA","r":"うた・ダンス","x":"https://x.com/yun_07222525","i":""}],"al":["スターズ","STARS"]},"SO.ON project":{"c":"アイドル","p":"JIKEI COMグループ（滋慶学園）の高等課程・高等専修学校に通うリアル女子高生によるアイドルプロジェクト（現行16期生）の総称。関西では大阪校チーム「SO.ON project OSAKA」（大阪スクールオブミュージック高等専修学校）と、その支部「SO.ON project OSAKA 神戸支部」（神戸・甲陽音楽ダンス＆アート高等専修学校、2019年発足）が出演する。メンバー名簿は公式サイト掲載の2026年11月19日時点（3年生：大阪校20名・神戸支部5名）。このほか2年生・1年生が多数在籍しており、本人の公式SNS等で氏名・学年を確認できた者から順次追加している。バーチャルアイドルユニット「SO.ON project LaV」は別アーティストとして登録。","w":"https://www.so-on-project.jp/","x":"https://x.com/so_on_project","i":"https://www.instagram.com/so.on_project/","m":[{"n":"赤木汐夏","r":"3年生・MY SCHOOL・海組 MY SCHOOLキャプテン","x":"","i":""},{"n":"一ノ瀬まい","r":"3年生・high color","x":"","i":""},{"n":"いとう りん","r":"3年生・MY SCHOOL","x":"","i":""},{"n":"掛水妃由","r":"3年生・high color・海組","x":"","i":""},{"n":"齊戸陽華","r":"3年生・high color・空組","x":"","i":""},{"n":"柴田姫菜","r":"3年生・high color・空組","x":"","i":""},{"n":"陣鎌寧音","r":"3年生・high color・空組","x":"","i":""},{"n":"高橋莉暖","r":"3年生・high color・海組","x":"","i":""},{"n":"田中芽蕗","r":"3年生・MY SCHOOL・海組","x":"","i":""},{"n":"伊達碧奏","r":"3年生・high color・海組","x":"","i":""},{"n":"内貴來羽","r":"3年生・MY SCHOOL・空組","x":"","i":""},{"n":"中村菜奈羽","r":"3年生・high color・海組","x":"","i":""},{"n":"苦瓜樹里","r":"3年生・high color・空組","x":"","i":""},{"n":"則包莉々愛","r":"3年生・MY SCHOOL・海組","x":"","i":""},{"n":"橋本優奈","r":"3年生","x":"","i":""},{"n":"平瀬愛衣","r":"3年生・high color・海組 high colorキャプテン","x":"","i":""},{"n":"廣井美月","r":"3年生・high color・空組 high colorキャプテン","x":"","i":""},{"n":"三國遥","r":"3年生・MY SCHOOL","x":"","i":""},{"n":"山下七海","r":"3年生","x":"","i":""},{"n":"吉田愛桜","r":"3年生・MY SCHOOL・海組","x":"","i":""},{"n":"江口莉埜愛","r":"1年生・MY SCHOOL・海組","x":"https://x.com/rinoa__soon","i":""},{"n":"小野田茉凛","r":"3年生・high color・16期 神戸支部リーダー","x":"","i":""},{"n":"佐々木優花","r":"3年生・high color","x":"","i":""},{"n":"高原優成","r":"3年生・MY SCHOOL","x":"","i":""},{"n":"田中鳳華","r":"3年生・high color","x":"","i":""},{"n":"松本彩佳","r":"3年生・high color","x":"","i":""}],"al":["SO.ON project OSAKA","SO.ON project OSAKA 神戸支部"]},"SO.ON project LaV":{"c":"アイドル","p":"SO.ON projectから2021年9月にデビューしたバーチャルアイドルユニット「LaV（ラブイ）」。固定5人制で、学年はメンバー個人の属性（学年や組の下部ユニットはなし）。SO.ON project本体とは別アーティ